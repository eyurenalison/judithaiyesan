{
  "name": "judith-aiyesan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check app auth.ts next.config.ts package.json tsconfig.json biome.json prisma.config.ts",
    "format": "biome format --write app auth.ts next.config.ts package.json tsconfig.json biome.json prisma.config.ts",
    "check": "bun run lint && bun run build",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "bun prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "lint-staged": {
    "*.{css,json,ts,tsx}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "embla-carousel-react": "^8.6.0",
    "next": "latest",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.20.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prisma": "^7.8.0",
    "typescript": "latest"
  }
}
